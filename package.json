{
  "name": "yasig-menu",
  "displayName": "야식메뉴판",
  "version": "2.6.1",
  "description": "야식 관리에 도움이 되는 가벼운 앱",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qqoro/yasig-menu.git"
  },
  "main": "main/main.js",
  "author": {
    "name": "qqoro"
  },
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build": "tsc --noEmit && node scripts/build.js && electron-builder --win --publish=never",
    "build:port": "tsc --noEmit && node scripts/build.js && electron-builder --win portable --publish=never",
    "build:win": "tsc --noEmit && node scripts/build.js && electron-builder --win --publish=never",
    "build:port:win": "tsc --noEmit && node scripts/build.js && electron-builder --win portable --publish=never",
    "prepare": "husky",
    "postinstall": "electron-builder install-app-deps",
    "lint": "oxlint",
    "format": "prettier src/ --write"
  },
  "type": "module",
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.50",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/solar": "^1.2.5",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify/vue": "^5.0.0",
    "@types/node": "^24.10.1",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "chalk": "^5.6.2",
    "chokidar": "^4.0.3",
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "husky": "^9.1.7",
    "oxlint": "^1.36.0",
    "prettier": "^3.7.4",
    "semver": "^7.7.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.10.1",
    "@tailwindcss/vite": "^4.1.18",
    "@vueuse/core": "^14.1.0",
    "better-sqlite3": "^12.5.0",
    "chrome-launcher": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "electron-window-state": "^5.0.3",
    "fast-glob": "^3.3.3",
    "iconv-lite": "^0.7.1",
    "knex": "^3.1.0",
    "lucide-vue-next": "^0.562.0",
    "node-html-parser": "^7.0.1",
    "pinia": "^3.0.4",
    "pretendard": "^1.3.9",
    "puppeteer-core": "^24.34.0",
    "reka-ui": "^2.7.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.26",
    "vue-router": "4",
    "vue-sonner": "^2.0.9"
  },
  "packageManager": "pnpm@10.26.2",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ],
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "better-sqlite3",
      "electron",
      "puppeteer"
    ],
    "overrides": {
      "node-abi": "^3.78.0"
    }
  }
}
